    "learning.aiAdjustment.export": {
      "module": "analytics",
      "effect": "query",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deckId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "pattern": "^[A-Za-z0-9_:.-]+$"
          },
          "jobId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "date": {
            "default": {
              "range": "all"
            },
            "type": "object",
            "properties": {
              "range": {
                "default": "30",
                "type": "string",
                "enum": [
                  "7",
                  "30",
                  "90",
                  "all",
                  "custom"
                ]
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            },
            "required": [
              "range"
            ],
            "additionalProperties": false
          },
          "includeImages": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "deckId",
          "jobId",
          "date",
          "includeImages"
        ],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "saved": {
            "type": "boolean"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "cardCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "eventCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "snapshotId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 150,
                "pattern": "^[A-Za-z0-9_:.-]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "saved",
          "name",
          "cardCount",
          "eventCount",
          "snapshotId"
        ],
        "additionalProperties": false
      }
    },
    "learning.aiAdjustment.export.status": {
      "module": "analytics",
      "effect": "query",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "jobId"
        ],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "idle",
              "choosing",
              "writing",
              "validating",
              "done",
              "cancelled",
              "failed"
            ]
          },
          "cardCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "eventCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "phase",
          "cardCount",
          "eventCount",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "learning.aiAdjustment.export.cancel": {
      "module": "analytics",
      "effect": "query",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "jobId"
        ],
        "additionalProperties": false
